{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "doctor-de-columna",
  "compatibility_date": "2026-05-08",
  "observability": {
    "enabled": true
  },
  "assets": {
    // Redesigned site (Version B). The previous site remains in ./first-version for rollback.
    "directory": "./doctor-de-columna",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
